NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://tracker:change-me@127.0.0.1:5432/tracker
DATABASE_SSL=false
# Docker Compose only; use a long alphanumeric password or URL-encode it in DATABASE_URL.
POSTGRES_USER=tracker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tracker
POSTGRES_PORT=5433
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
SESSION_TTL_HOURS=168
LOG_LEVEL=info
# Only set when behind a trusted reverse proxy. Default: no proxy trust.
TRUST_PROXY_HOPS=0
# Explicit opt-in for db:seed, never allowed in production.
ALLOW_DEMO_SEED=false
# admin:create reads these values; never commit real credentials.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Administrator
# Tests auto-start an isolated local PostgreSQL when binaries are on PATH.
# PG_BIN=C:/Program Files/PostgreSQL/17/bin
# Alternatively, a dedicated PostgreSQL database; tests use a random schema.
# TEST_DATABASE_URL=postgresql://tracker:change-me@127.0.0.1:5432/tracker_test
