# Скопируйте файл как .env.production и замените примерные значения.
# Никогда не добавляйте .env.production в Git.

# Публичное DNS-имя, A-запись которого указывает на NuxtCloud VPS.
# Только имя хоста: без https://, пути и завершающего слэша.
APP_DOMAIN=tracker.example.com

# Supabase Dashboard -> Connect -> Session pooler, порт 5432.
# Одинарные кавычки защищают спецсимволы пароля от подстановки Docker Compose.
# Если вводите URL вручную, URL-кодируйте символы пароля (например, @ как %40).
DATABASE_URL='postgresql://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres'

# Для Supabase TLS обязателен; deploy-скрипт отклонит false.
DATABASE_SSL=true

SESSION_TTL_HOURS=168
LOG_LEVEL=info
