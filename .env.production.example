# Скопируйте файл как .env.production и замените примерные значения.
# Никогда не добавляйте .env.production в Git.

# Публичное DNS-имя, A-запись которого указывает на NuxtCloud VPS.
# Только имя хоста: без https://, пути и завершающего слэша.
APP_DOMAIN=tracker.example.com

# Локальная PostgreSQL внутри Docker. Имена меняйте только до первого запуска.
POSTGRES_DB=tracker
POSTGRES_USER=tracker
# Используйте только латинские буквы и цифры, минимум 32 символа.
# Например: openssl rand -hex 32
POSTGRES_PASSWORD=GENERATE_WITH_OPENSSL_RAND_HEX_32

SESSION_TTL_HOURS=168
LOG_LEVEL=info

# Число дней хранения локальных резервных копий из deploy/backup.sh.
BACKUP_RETENTION_DAYS=14
